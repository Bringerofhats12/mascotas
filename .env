
# Dirección del servidor de PostgreSQL (host/IP)
DB_HOST=localhost

# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432

# Nombre de la base de datos
DB_DATABASE=PatitasConAmor

# Credenciales
DB_USER=postgres
DB_PASSWORD=

# SSL: la mayoría de servicios administrados en la nube (Azure, AWS, etc.)
DB_SSL=false

# Puerto en el que correrá la aplicación Node.js
PORT=3000

# Cámbiala por cualquier texto largo y aleatorio antes de producción.
SESSION_SECRET=cambia-esta-clave-por-una-propia